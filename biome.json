{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!.claude"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "all",
      "react": "all",
      "project": "all",
      "types": "all",
      "tailwind": "all",
      "playwright": "none",
      "test": "none",
      "astro": "none",
      "drizzle": "none",
      "qwik": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "turborepo": "none",
      "vue": "none"
    },
    "rules": {
      "preset": "all",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "useMaxParams": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        "noProcessGlobal": "off",
        "useImportExtensions": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "style": {
        "noContinue": "off",
        "noDefaultExport": "off",
        "noDescendingSpecificity": "off",
        "noExcessiveLinesPerFile": "off",
        "noHexColors": "off",
        "noImplicitBoolean": "off",
        "noIncrementDecrement": "off",
        "noJsxLiterals": "off",
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "noProcessEnv": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useComponentExportOnlyModules": "off",
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useNamingConvention": {
          "level": "on",
          "options": {
            "strictCase": false
          }
        }
      },
      "suspicious": {
        "noBitwiseOperators": "off",
        "noConsole": {
          "level": "on",
          "options": {
            "allow": ["error"]
          }
        }
      },
      "nursery": {
        "noTailwindArbitraryValue": "off",
        "useReactCompiler": "error",
        "useTailwindShorthandClasses": "error",
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cx"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "playwright.config.ts"],
      "linter": {
        "domains": {
          "playwright": "all",
          "test": "all"
        },
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noSkippedTests": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/manifest.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
